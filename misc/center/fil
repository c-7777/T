set -euo pipefail

[[ $# -eq 1 ]] || exit 1
a="$1"
[[ -d "$a" ]] || exit 1

find "$a" -depth -type d -print0 | while IFS= read -r -d '' b; do
  shopt -s nullglob dotglob
  c=("$b"/*)
  shopt -u nullglob dotglob

  if [[ ${#c[@]} -eq 0 ]]; then
    touch "$b/.placeholder"
  else
    d="$b/.placeholder"
    if [[ -f "$d" || -L "$d" ]]; then
      e=0
      for f in "${c[@]}"; do
        if [[ "$f" != "$d" ]]; then
          e=1
          break
        fi
      done
      if [[ $e -eq 1 ]]; then
        rm -f -- "$d"
      fi
    fi
  fi
done
